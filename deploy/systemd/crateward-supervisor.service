[Unit]
Description=Crateward supervisor: breakers, canaries, escape checks, alerts
Documentation=https://github.com/janfedler/crateward/blob/main/docs/OPERATIONS.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
RequiresMountsFor=/var/lib/crateward /run/crateward

[Service]
Type=simple
User=crateward-supervisor
Group=crateward
UMask=0027
Environment=CRATEWARD_CONFIG=/etc/crateward/crateward.toml
ExecStart=/usr/local/lib/crateward/bin/crateward-supervisor
Restart=on-failure
RestartSec=10
# The current step finishes after SIGTERM.
TimeoutStopSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
# The decoys include a home directory.
ProtectHome=no
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Decoys are planted here. The integrity manifest and /proc are read.
ReadWritePaths=/home/crateward /var/lib/crateward/decoys
ReadOnlyPaths=/var/lib/crateward /run/crateward

[Install]
WantedBy=multi-user.target
