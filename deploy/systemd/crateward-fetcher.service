[Unit]
Description=Crateward fetcher: resolves, downloads and validates crates
Documentation=https://github.com/janfedler/crateward/blob/main/docs/OPERATIONS.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
RequiresMountsFor=/var/lib/crateward /run/crateward

[Service]
Type=simple
User=crateward-fetcher
Group=crateward
UMask=0027
Environment=CRATEWARD_CONFIG=/etc/crateward/crateward.toml
ExecStart=/usr/local/lib/crateward/bin/crateward_fetcher
Restart=on-failure
RestartSec=10
# The current step finishes after SIGTERM.
TimeoutStopSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=user net
# The resolution and validation children run in their own user and network
# namespaces and set up their loopback with ip(8), which needs netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/crateward /run/crateward

[Install]
WantedBy=multi-user.target
