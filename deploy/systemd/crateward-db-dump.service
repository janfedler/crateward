[Unit]
Description=Crateward database dump (latest only)
Documentation=https://github.com/janfedler/crateward/blob/main/docs/OPERATIONS.md
After=postgresql.service

[Service]
Type=oneshot
User=postgres
UMask=0077
# Streamed into a temporary file and renamed, so a failed dump never
# replaces the last good one.
ExecStart=/bin/sh -c 'pg_dump --format=custom --compress=zstd:9 crateward > /var/backups/crateward/crateward.dump.tmp && mv /var/backups/crateward/crateward.dump.tmp /var/backups/crateward/crateward.dump'
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/var/backups/crateward
