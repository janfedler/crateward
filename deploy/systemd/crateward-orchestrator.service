[Unit]
Description=Crateward orchestrator: runs jobs in Firecracker microVMs
Documentation=https://github.com/janfedler/crateward/blob/main/docs/OPERATIONS.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
RequiresMountsFor=/var/lib/crateward /run/crateward

[Service]
Type=simple
User=crateward-orchestrator
Group=crateward
UMask=0027
Environment=CRATEWARD_CONFIG=/etc/crateward/crateward.toml
ExecStart=/usr/local/lib/crateward/bin/crateward-orchestrator
Restart=on-failure
RestartSec=10
# Running jobs finish after SIGTERM. A full build may take
# sandbox.full_timeout_secs (45 minutes), plus the payload, the scratch
# scan and cleanup. A test keeps this above the configured timeout.
TimeoutStopSec=60min
# ADR 0002: the rootless jail needs newuidmap and newgidmap (setuid), user,
# mount, network, IPC and UTS namespaces, /dev/kvm and /dev/net/tun, and a
# delegated cgroup subtree for the slot limits. Every jailed Firecracker
# keeps the supplementary groups, so kvm is the only one.
SupplementaryGroups=kvm
Delegate=yes
KillMode=mixed
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
# No ProtectHostname: it blocks sethostname in every UTS namespace,
# including the one the jail names. The service holds no capabilities, so
# it cannot rename the host either way.
ProtectHostname=no
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# The service holds no capabilities. The bounding set limits what setuid
# programs gain. newuidmap and newgidmap run as root and open the ID maps
# of a jail owned by the service user, and the kernel accepts a map only
# from a writer with CAP_SETUID or CAP_SETGID and CAP_SYS_ADMIN. The other
# setuid programs are hidden.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_SYS_ADMIN
AmbientCapabilities=
InaccessiblePaths=-/usr/bin/su -/usr/bin/sudo -/usr/bin/mount -/usr/bin/umount
InaccessiblePaths=-/usr/bin/passwd -/usr/bin/chsh -/usr/bin/chfn -/usr/bin/gpasswd
InaccessiblePaths=-/usr/bin/newgrp -/usr/bin/at -/usr/lib/openssh/ssh-keysign
InaccessiblePaths=-/usr/lib/dbus-1.0/dbus-daemon-launch-helper
# AF_PACKET: the capture of frames the proxies do not see (ADR 0006).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
ReadWritePaths=/run/crateward
ReadOnlyPaths=/var/lib/crateward

[Install]
WantedBy=multi-user.target
