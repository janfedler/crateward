PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
{% if ssh_wireguard_only %}
# Only through the tunnel (THREAT_MODEL.md, "No inbound service except
# WireGuard"). The firewall also allows SSH on wg0 only.
ListenAddress {{ wireguard_address.split('/')[0] }}
{% endif %}
