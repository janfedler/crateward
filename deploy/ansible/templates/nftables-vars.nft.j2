# Written by Ansible (deploy/ansible/site.yml); read by crateward.nft.
define WG_PORT = {{ wireguard_port }}
define SSH_PORT = {{ ssh_port }}
{% if ssh_wireguard_only | bool %}
define SSH_IFACES = { "wg0" }
{% else %}
# Until WireGuard is confirmed working, SSH stays reachable publicly too.
define SSH_IFACES = { "wg0", "{{ ansible_facts.default_ipv4.interface }}" }
{% endif %}
# sandbox.slot_uid_base to slot_uid_base + slots (the spare slot included).
define SLOT_UIDS = {{ slot_id_base }}-{{ slot_id_base + slots }}
define FEED_UID = {{ getent_passwd['crateward-feed'][1] }}
define FETCHER_UID = {{ getent_passwd['crateward-fetcher'][1] }}
define STATIC_UID = {{ getent_passwd['crateward-static'][1] }}
define ORCHESTRATOR_UID = {{ getent_passwd['crateward-orchestrator'][1] }}
define ANALYZER_UID = {{ getent_passwd['crateward-analyzer'][1] }}
define API_UID = {{ getent_passwd['crateward-api'][1] }}
define SUPERVISOR_UID = {{ getent_passwd['crateward-supervisor'][1] }}
define BUILDER_UID = {{ getent_passwd['crateward-builder'][1] }}
