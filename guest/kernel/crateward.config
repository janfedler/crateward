# Crateward changes on top of firecracker-6.18-x86_64.config.
#
# `cargo xtask guest-kernel` merges this fragment into the Firecracker base
# with the kernel's own merge_config.sh, runs `make olddefconfig`, and then
# fails if any line below did not survive. Kconfig silently drops options
# whose dependencies are unmet, so the check is what makes this file honest.

# No loadable modules: a crate that reaches guest root cannot load code into
# the guest kernel, for example to blind the eBPF tracing.
# CONFIG_MODULES is not set

# No raw physical memory access and no suspend to disk from inside the guest.
# CONFIG_DEVMEM is not set
# CONFIG_HIBERNATION is not set

# Read only compressed images for the root filesystem and job payloads, and
# overlayfs to stack a writable layer on top of them.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y

# eBPF tracing for the guest agent (ADR 0007): the JIT, kprobe and tracepoint
# events, type information (BTF) for portable programs, and the BPF LSM whose
# hooks see the objects the kernel actually resolved.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_LSM=y
# LSM programs attach through BPF trampolines, which patch the entry of the
# hook function. Without the function tracer's patchable entries, attaching
# fails with EBUSY.
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_DYNAMIC_FTRACE_WITH_DIRECT_CALLS=y

# Snapshot uniqueness: the guest reseeds its random number generator when
# Firecracker changes the VM generation ID on restore.
CONFIG_VMGENID=y
CONFIG_HW_RANDOM_VIRTIO=y
